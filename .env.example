# ==========================================================
# تنظیمات بک‌اند آیوهوش
# متغیرهای «اختیاری» را اگر لازم ندارید کامنت‌شده بگذارید؛
# خط خالی (مثل X=) با مقدار پیش‌فرض یکی نیست و برای متغیرهای
# عددی باعث خطای شروع برنامه می‌شود.
# ==========================================================

# --- Django
SECRET_KEY=
JWT_SIGNING_KEY=
DEBUG=False
ALLOWED_HOSTS=api.aiohoush.com
CORS_ALLOWED_ORIGINS=https://www.aiohoush.com
CSRF_TRUSTED_ORIGINS=https://www.aiohoush.com,https://api.aiohoush.com

# --- PostgreSQL
DB_NAME=
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=5432

# --- Redis (هر کدام یک دیتابیس جدا)
REDIS_CACHE_URL=redis://default:PASSWORD@HOST:6379/0
THROTTLE_REDIS_URL=redis://default:PASSWORD@HOST:6379/1
CELERY_BROKER_URL=redis://default:PASSWORD@HOST:6379/2

# --- OTP
OTP_LENGTH=6
OTP_EXPIRATION_SECONDS=120
OTP_REQUEST_LIMIT_24H=24
# محدودیت درخواست (در DEBUG=True نادیده گرفته می‌شوند)
OTP_MOBILE_THROTTLE_RATE=5/hour
OTP_IP_THROTTLE_RATE=250/hour
OTP_VERIFY_MOBILE_THROTTLE_RATE=10/hour
OTP_VERIFY_IP_THROTTLE_RATE=500/hour

# --- پیامک (پیام‌رسان)
PAYAMRESAN_API_URL=https://api.sms-webservice.com/api/V3/SendMultiple
PAYAMRESAN_API_KEY=
PAYAMRESAN_SENDER=
SMS_CONNECT_TIMEOUT=15
SMS_READ_TIMEOUT=15

# --- آدرس فرانت (برای ریدایرکت‌ها)
APP_ORIGIN=https://www.aiohoush.com

# --- پرداخت محصولات AI از طریق ویدوپل
VIDEOPOL_API_URL=https://api.videopol.ir
# باید با AIOHOUSH_API_KEY در ویدوپل یکی باشد
VIDEOPOL_API_KEY=
# VIDEOPOL_TIMEOUT_SECONDS=15
# hostname باید با AIOHOUSH_ALLOWED_CALLBACK_HOST در ویدوپل یکی باشد
AI_PAYMENT_CALLBACK_URL=https://api.aiohoush.com/order/ai-products/payment-return/
AI_PAYMENT_RESULT_URL=https://www.aiohoush.com/dashboard/ai

# --- IP واقعی کاربر
# باید با BFF_SHARED_SECRET در فرانت یکی باشد. ساخت:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BFF_SHARED_SECRET=
# اختیاری: هدر IP در درخواست‌هایی که مستقیم به جنگو می‌رسند
# (HTTP_X_REAL_IP یا HTTP_X_FORWARDED_FOR). کامنت = REMOTE_ADDR
# CLIENT_IP_META_KEY=HTTP_X_REAL_IP
# TRUSTED_PROXY_COUNT=1

# --- فایل‌های محافظت‌شده (سورس کد جلسات)
# باید روی دیسک ماندگار باشد و توسط وب‌سرور سرو نشود.
# پیش‌فرض: <پروژه>/private_media
# PRIVATE_MEDIA_ROOT=/data/private_media
